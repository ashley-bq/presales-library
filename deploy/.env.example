# 复制为项目根目录下的 .env（不要提交到仓库）
# 访问域名（需已解析到服务器 IP）；没有域名就留空，用 http://服务器IP 访问
PSL_DOMAIN=
# 素材仓库（服务器用部署密钥读写）
PSL_REPO=git@github.com:ashley-bq/presales-library.git
# AI 模型（OpenAI 兼容接口）：DeepSeek 示例；通义：https://dashscope.aliyuncs.com/compatible-mode/v1 / qwen-plus；豆包：https://ark.cn-beijing.volces.com/api/v3 / <接入点ID>
PSL_LLM_BASE_URL=https://api.deepseek.com/v1
PSL_LLM_API_KEY=
PSL_LLM_MODEL=deepseek-chat
